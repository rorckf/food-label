# 复制本文件为 .env 并填写真实值（.env 已在 .gitignore 中，不会被提交）
# cp .env.example .env

# MySQL root 密码（自定义一个强密码）
DB_PASSWORD=

# 阿里云百炼/灵积 Qwen-VL 的 API Key（https://bailian.console.aliyun.com 获取）
QWEN_API_KEY=

# JWT 签名密钥：随机字符串，至少 32 个字符
JWT_SECRET=

# 管理后台 admin 账号的初始密码（公网部署务必改掉默认值）
ADMIN_SEED_PASSWORD=

# 上传图片的外网访问地址前缀：http://你的服务器IP/uploads
FILE_BASE_URL=
